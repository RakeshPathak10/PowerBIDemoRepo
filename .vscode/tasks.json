{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Power BI: Open Review Gate",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-File",
                "${env:USERPROFILE}\\PowerBIReviewGate\\Start.ps1",
                "-Repository",
                "${workspaceFolder}"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "Power BI: Sign in to Copilot CLI",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-File",
                "${env:USERPROFILE}\\PowerBIReviewGate\\Start.ps1",
                "-Login",
                "-DeviceCode"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "runOptions": {
                "instanceLimit": 1
            }
        }
    ]
}
